#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "../protos/RetroBot.proto"

WorldInfo {
  info [ "retrobot - 회상 기반 심리 치료 로봇 시뮬레이션" ]
  title "retrobot"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.33 0.25 0.91 1.9
  position 2.6 -5.2 3.6
}
TexturedBackground {
  texture "empty_office"
  skyColor [ 0.15 0.15 0.18 ]
}
TexturedBackgroundLight {
  texture "empty_office"
  luminosity 0.6
}
RectangleArena {
  floorSize 8 10
  floorTileSize 1 1
  wallHeight 0.6
}

# ================= 치료실 =================
# 내담자 의자 + 내담자(단순 형상)
DEF PATIENT_CHAIR Solid {
  translation 1.3 0 0
  name "patient_chair"
  children [
    Pose {
      translation 0 0 0.22
      children [
        Shape {
          appearance DEF WOOD PBRAppearance { baseColor 0.45 0.3 0.18 roughness 0.8 metalness 0 }
          geometry Box { size 0.45 0.45 0.05 }
        }
      ]
    }
    Pose {
      translation 0.2 0 0.47
      children [ Shape { appearance USE WOOD geometry Box { size 0.05 0.45 0.5 } } ]
    }
  ]
}
DEF PATIENT Solid {
  translation 1.32 0 0.25
  name "patient"
  children [
    Pose {
      translation 0 0 0.3
      children [
        Shape {
          appearance DEF CLOTH PBRAppearance { baseColor 0.35 0.45 0.6 roughness 1 metalness 0 }
          geometry Capsule { height 0.3 radius 0.13 }
        }
      ]
    }
    Pose {
      translation 0 0 0.66
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.92 0.78 0.65 roughness 1 metalness 0 }
          geometry Sphere { radius 0.1 }
        }
      ]
    }
  ]
}

# 로봇 (정면 +X → 내담자를 바라봄)
RetroBot {
  translation 0 0 0
  controller "retrobot"
  supervisor TRUE
}

# ================= 기억 무대 =================
# 컨트롤러(scene_builder.py)가 이 Pose의 children에 기억 속 장소/물건을 생성함
DEF MEMORY_STAGE Pose {
  translation 0.6 -3.2 0
  children [ ]
}
DEF MEMORY_LIGHT PointLight {
  location 0.6 -3.2 2.2
  color 1 1 1
  intensity 0
  radius 6
  castShadows FALSE
}
# 무대 경계 표시
Solid {
  translation 0.6 -3.2 0.003
  name "stage_marker"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.2 0.22 roughness 1 metalness 0 }
      geometry Box { size 3.2 2.6 0.004 }
    }
  ]
}
